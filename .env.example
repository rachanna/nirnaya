# Copy to .env and fill in. Never commit .env.

# Investigating agent (Milestone 4). scripted = no model, no tokens; llm = use the provider below.
NIRNAYA_AGENT=scripted
# Provider: anthropic (default) or openai.
NIRNAYA_LLM_PROVIDER=anthropic
# Model id. Defaults to claude-sonnet-5-5 for anthropic; required for openai.
NIRNAYA_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# Safety: no write reaches Airwallex unless this is explicitly false.
DRY_RUN=true

# Airwallex sandbox: keys from the sandbox web app, Account > Developer > API keys.
# The business must be registered in a country with online payment acceptance (e.g. US).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# LangSmith (optional). Tracing of model calls is off unless LANGSMITH_TRACING=true.
# The key alone is enough to mirror prompts and upload eval experiments
# (python -m nirnaya.integrations.langsmith prompts|experiments).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Optional: a regional or self-hosted endpoint.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=nirnaya
