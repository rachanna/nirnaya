# Copy to .env and fill in. Never commit .env.

# Investigating agent (Milestone 4). Provider: anthropic (default) or openai.
NIRNAYA_LLM_PROVIDER=anthropic
# Model id. Defaults to claude-sonnet-5-5 for anthropic; required for openai.
NIRNAYA_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# Safety: no write reaches Airwallex unless this is explicitly false.
DRY_RUN=true

# Airwallex sandbox (Milestone 5)
# TODO(verify-airwallex-docs): confirm credential names and the sandbox base URL.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=
